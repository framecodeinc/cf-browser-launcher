{
  "name": "cf-browser-launcher",
  "displayName": "ColdFusion Browser Launcher",
  "description": "Run and debug ColdFusion files (.cfm, .cfc) against your local Adobe ColdFusion server in a browser of your choice.",
  "version": "1.1.7",
  "publisher": "framecode",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/framecodeinc/cf-browser-launcher"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onDebugResolve:cfbl-cfml-debugger"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "cfBrowserLauncher.openInDefault",
        "title": "Run ColdFusion File in Default Browser",
        "category": "CF Browser Launcher"
      },
      {
        "command": "cfBrowserLauncher.chooseBrowser",
        "title": "Run ColdFusion File in...",
        "category": "CF Browser Launcher"
      },
      {
        "command": "cfBrowserLauncher.debugInDefault",
        "title": "Debug ColdFusion File in Default Browser",
        "category": "CF Browser Launcher"
      },
      {
        "command": "cfBrowserLauncher.debugChooseBrowser",
        "title": "Debug ColdFusion File in...",
        "category": "CF Browser Launcher"
      },
      {
        "command": "cfBrowserLauncher.forgetProjects",
        "title": "Forget Remembered Projects",
        "category": "CF Browser Launcher"
      },
      {
        "command": "cfBrowserLauncher.showLog",
        "title": "Show Log",
        "category": "CF Browser Launcher"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .cfm || resourceExtname == .cfc",
          "command": "cfBrowserLauncher.openInDefault",
          "group": "0_cfBrowserLauncher@1"
        },
        {
          "when": "resourceExtname == .cfm || resourceExtname == .cfc",
          "command": "cfBrowserLauncher.chooseBrowser",
          "group": "0_cfBrowserLauncher@2"
        },
        {
          "when": "resourceExtname == .cfm || resourceExtname == .cfc",
          "command": "cfBrowserLauncher.debugInDefault",
          "group": "0_cfBrowserLauncher@3"
        },
        {
          "when": "resourceExtname == .cfm || resourceExtname == .cfc",
          "command": "cfBrowserLauncher.debugChooseBrowser",
          "group": "0_cfBrowserLauncher@4"
        }
      ],
      "commandPalette": [
        {
          "command": "cfBrowserLauncher.openInDefault",
          "when": "resourceExtname == .cfm || resourceExtname == .cfc"
        },
        {
          "command": "cfBrowserLauncher.chooseBrowser",
          "when": "resourceExtname == .cfm || resourceExtname == .cfc"
        },
        {
          "command": "cfBrowserLauncher.debugInDefault",
          "when": "resourceExtname == .cfm || resourceExtname == .cfc"
        },
        {
          "command": "cfBrowserLauncher.debugChooseBrowser",
          "when": "resourceExtname == .cfm || resourceExtname == .cfc"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname == .cfm || resourceExtname == .cfc",
          "command": "cfBrowserLauncher.openInDefault",
          "group": "0_cfBrowserLauncher@1"
        },
        {
          "when": "resourceExtname == .cfm || resourceExtname == .cfc",
          "command": "cfBrowserLauncher.chooseBrowser",
          "group": "0_cfBrowserLauncher@2"
        },
        {
          "when": "resourceExtname == .cfm || resourceExtname == .cfc",
          "command": "cfBrowserLauncher.debugInDefault",
          "group": "0_cfBrowserLauncher@3"
        },
        {
          "when": "resourceExtname == .cfm || resourceExtname == .cfc",
          "command": "cfBrowserLauncher.debugChooseBrowser",
          "group": "0_cfBrowserLauncher@4"
        }
      ]
    },
    "configuration": {
      "title": "ColdFusion Browser Launcher",
      "properties": {
        "cfBrowserLauncher.serverHost": {
          "type": "string",
          "default": "http://localhost:8500",
          "description": "Adobe ColdFusion server host and port by default: http://localhost:8500"
        },
        "cfBrowserLauncher.documentRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path on disk that corresponds to a single CF project's root, for example: C:\\ColdFusion2025\\cfusion\\wwwroot\\my-project. Leave empty to auto-detect it as the root of the workspace folder that contains the file you right-clicked (recommended, works with multi-root workspaces where each root is a different CF project)."
        },
        "cfBrowserLauncher.projectName": {
          "type": "string",
          "default": "",
          "description": "Project name used as the URL segment right after serverHost, e.g. the 'my-project' in http://localhost:8500/my-project/file.cfm. Leave empty to auto-detect it from the name of the resolved document root folder (recommended)."
        },
        "cfBrowserLauncher.defaultBrowser": {
          "type": "string",
          "default": "",
          "description": "Key (within 'browsers') used by 'Run ColdFusion File in Default Browser' and 'Debug ColdFusion File in Default Browser'. Leave empty to use the operating system's default browser. Set it to one of your 'browsers' keys (e.g. 'brave') to always use that specific browser instead."
        },
        "cfBrowserLauncher.browsers": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "description": "Absolute path to this browser's executable."
          },
          "description": "Extra browsers, or paths that replace a built-in one: map of name -> absolute path of the browser's executable. Chrome, Edge, Firefox and Chromium are already included for your operating system (see the README for their paths)."
        }
      }
    },
    "debuggers": [
      {
        "type": "cfbl-cfml-debugger",
        "label": "CFML Debug (CF Browser Launcher)",
        "languages": [
          "cfml"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path of the .cfm file to debug."
              },
              "globalConfigFilePath": {
                "type": "string",
                "description": "Path of Adobe's adobe-cfml.json."
              },
              "project": {
                "description": "Adobe ColdFusion Builder project (object or JSON string)."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "trace": {
                "type": "boolean",
                "default": false
              },
              "cfblBrowserPath": {
                "type": "string",
                "description": "Absolute path of the browser executable to open the debug URL with."
              },
              "cfblStatusFile": {
                "type": "string",
                "description": "Internal: file used to report the browser launch result."
              },
              "cfblSystemDefault": {
                "type": "boolean",
                "description": "Use the system default browser, without waiting for it to close (Linux)."
              }
            }
          }
        }
      }
    ]
  }
}
